---
import Mark from "./Mark.astro";
import Install from "./Install.astro";
import type { Release } from "../lib/release";

interface Props {
  release: Release | null;
}
const { release } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="art" aria-hidden="true" data-drift>
    <Mark class="hero-mark" animate />
  </div>

  <div class="frame copy">
    <h1 id="hero-title" class="title" data-hero-title>Take control of your AI&nbsp;workflow.</h1>
    <div class="tide" aria-hidden="true" data-hero-tide>
      <svg class="tideline" viewBox="0 0 1440 80" preserveAspectRatio="none">
        <path
          class="tideline-path"
          d="M0 50 C 180 50, 300 18, 520 20 S 860 70, 1080 62 S 1340 30, 1440 34"></path>
      </svg>
    </div>
    <p class="lede" data-hero-follow>
      See every Claude account's tide and switch before one runs dry. One control center for your AI coding accounts,
      usage and sessions.
    </p>
    <div class="action" id="install-top" data-hero-follow>
      <Install release={release} />
    </div>
  </div>
</section>

<style>
  .hero {
    /* One sizing rule for the mark, shared by everything that must clear it: the mark is sized by
       height, but never wider than 45% of the frame, so it can't run over the copy on a tall,
       narrow window. */
    --frame-w: calc(min(100vw, var(--max)) - 2 * var(--gutter));
    --mark-h: min(clamp(360px, 78vh, 860px), var(--frame-w) * 0.45 * 60 / 44);
    --clear-w: calc(var(--frame-w) - var(--mark-h) * 44 / 60 - 48px);
    position: relative;
    min-height: max(640px, min(100svh, 1000px));
    display: grid;
    align-items: end;
    padding-bottom: clamp(40px, 6vw, 88px);
    isolation: isolate;
    /* The full-bleed tide line is 100vw, which includes a classic scrollbar's width. */
    overflow-x: clip;
  }

  .art {
    position: absolute;
    z-index: -1;
    top: clamp(16px, 4vh, 48px);
    right: max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter)));
    height: var(--mark-h);
    aspect-ratio: 44 / 60;
  }
  .art :global(.hero-mark) {
    width: 100%;
    height: 100%;
  }

  /* Full-bleed water between the headline and the lede; it passes behind the mark. */
  .tide {
    position: relative;
    z-index: -2;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    height: clamp(44px, 5vw, 72px);
    margin-block: -6px -10px;
  }
  .tideline {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .tideline-path {
    fill: none;
    stroke: var(--live);
    stroke-width: 2.25px;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  .copy {
    display: grid;
    gap: 24px;
    padding-top: clamp(24px, 7vh, 64px);
  }
  .copy .lede {
    max-width: min(46ch, var(--clear-w));
  }

  .title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(3rem, min(7.4vw, 10.5vh), 6rem);
    line-height: 0.96;
    letter-spacing: -0.04em;
    max-width: min(15ch, var(--clear-w));
    text-wrap: balance;
  }

  .action {
    margin-top: 4px;
    max-width: min(52rem, var(--clear-w));
  }

  /* Hero entrance (scripts/motion.ts). Hidden states hold only while the motion script is due:
     html.js is set in <head>, and html.no-motion lands after 2.5 s if the script never starts. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js:not([data-still]):not(.no-motion)) .title {
      visibility: hidden;
    }
    /* The water is drawn by a wipe, not a dash: under non-scaling-stroke, Chrome ignores
       pathLength, so a dash of "1" breaks into fragments. */
    :global(html.js:not([data-still]):not(.no-motion)) .tideline {
      clip-path: inset(-24px 100% -24px 0);
    }
    :global(html.js:not([data-still]):not(.no-motion)) [data-hero-follow] {
      opacity: 0;
    }
    /* The swell starts once the line is drawn, and rests while the hero is off screen. */
    :global(html.js .tide.is-swelling) .tideline {
      animation: swell 7s ease-in-out infinite alternate;
    }
    :global(html.js .tide.is-resting) .tideline {
      animation-play-state: paused;
    }
  }

  @keyframes swell {
    from {
      transform: translateY(0) scaleY(1);
    }
    to {
      transform: translateY(4px) scaleY(0.82);
    }
  }

  /* Stack the poster on phones, and on any window taller than it is wide (portrait tablets). */
  @media (max-width: 760px), (max-aspect-ratio: 4 / 5) {
    .hero {
      --clear-w: 100%;
      min-height: 0;
      align-items: start;
      padding-top: 8px;
    }
    .art {
      position: relative;
      right: auto;
      top: auto;
      height: min(26vh, 220px);
      margin-left: auto;
      margin-right: var(--gutter);
    }
    .copy {
      padding-top: 28px;
      gap: 18px;
    }
  }
</style>
