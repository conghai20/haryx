# deploy/.env — made by `./gen-secrets.sh`, never committed. Three kinds of value:
#   generated  gen-secrets.sh fills it, and keeps it on rerun
#   default    leave empty unless this is not production
#   hand       gen-secrets.sh names it until you fill it
# Comments stay on their own lines: Compose reads `KEY=   # note` as the value "# note".

# --- compose.yaml (the API, Postgres, backups) ---
# generated
HARYX_DB_PASSWORD=
# generated; configure-haryx.mjs sets the same value on the haryx-api-admin client
HARYX_API_ADMIN_SECRET=
# default: https://sso.wecoap.com/realms/wecoap
HARYX_SSO_ISSUER=
# default: ./backups
HARYX_BACKUP_DIR=

# --- keycloak/configure-haryx.mjs (run once, and after each change to it) ---
# The Keycloak admin user and password are typed on the command line, never stored here.
# default: https://sso.wecoap.com
KC_URL=
# default: wecoap
KC_REALM=
# default: https://haryx.wecoap.com
HARYX_PLATFORM_URL=
# hand: Apple Developer → Identifiers → Services ID, the team id, and the Sign in with Apple key
APPLE_SERVICES_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# hand: path to that key's .p8 file on the machine that runs configure-haryx.mjs
APPLE_P8_FILE=
# hand: the no-reply@wecoap.com mailbox on mail.wecoap.com
SMTP_USER=
SMTP_PASSWORD=
