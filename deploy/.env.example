# deploy/.env — made by `./gen-secrets.sh`, never committed. Two kinds of value:
#   generated  gen-secrets.sh fills it, and keeps it on rerun
#   default    leave empty unless this is not production
# Comments stay on their own lines: Compose reads `KEY=   # note` as the value "# note".

# --- compose.yaml (the API, Postgres, backups) ---
# generated
HARYX_DB_PASSWORD=
# default: https://sso.wecoap.com/realms/wecoap
HARYX_SSO_ISSUER=
# default: ./backups
HARYX_BACKUP_DIR=
# default: latest. The HaryX version of the API image, wecoap/haryx:api-v<version> (e.g. 0.2.0)
HARYX_API_VERSION=

# The realm (clients, Apple, SMTP) is set up by hand in the Keycloak admin console, so its
# secrets live in Keycloak, never here: README → "Realm, by hand".
