{
  "clients": [
    {
      "clientId": "haryx-cli",
      "name": "HaryX CLI and apps",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": false,
      "fullScopeAllowed": false,
      "redirectUris": ["http://127.0.0.1/*"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "oauth2.device.authorization.grant.enabled": "true",
        "frontchannel.logout.session.required": "false"
      },
      "defaultClientScopes": ["acr", "basic", "email", "profile", "roles", "web-origins"],
      "optionalClientScopes": ["offline_access"],
      "protocolMappers": [
        {
          "name": "audience haryx-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "haryx-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "identity_provider",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "config": {
            "user.session.note": "identity_provider",
            "claim.name": "identity_provider",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "haryx-platform",
      "name": "HaryX on the web",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": false,
      "fullScopeAllowed": false,
      "baseUrl": "/platform/",
      "redirectUris": ["https://haryx.wecoap.com/platform/*", "http://127.0.0.1:5173/platform/*"],
      "webOrigins": ["https://haryx.wecoap.com", "http://127.0.0.1:5173"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "oauth2.device.authorization.grant.enabled": "false",
        "post.logout.redirect.uris": "https://haryx.wecoap.com/platform/*##http://127.0.0.1:5173/platform/*"
      },
      "defaultClientScopes": ["acr", "basic", "email", "profile", "roles", "web-origins"],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "audience haryx-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "haryx-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "identity_provider",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "config": {
            "user.session.note": "identity_provider",
            "claim.name": "identity_provider",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "e2e-a",
      "email": "e2e-a@example.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "E2E",
      "lastName": "User A",
      "requiredActions": []
    },
    {
      "username": "e2e-b",
      "email": "e2e-b@example.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "E2E",
      "lastName": "User B",
      "requiredActions": []
    }
  ]
}
