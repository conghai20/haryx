---
import Mark from "./Mark.astro";
import Install from "./Install.astro";
import type { Release } from "../lib/release";

interface Props {
  release: Release | null;
}
const { release } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="art" aria-hidden="true" data-drift>
    <Mark class="hero-mark" animate />
  </div>

  <div class="frame copy">
    <h1 id="hero-title" class="title">Route your AI&nbsp;accounts like&nbsp;water.</h1>
    <div class="tide" aria-hidden="true">
      <svg class="tideline" viewBox="0 0 1440 80" preserveAspectRatio="none">
        <path
          class="tideline-path"
          d="M0 50 C 180 50, 300 18, 520 20 S 860 70, 1080 62 S 1340 30, 1440 34"
          pathLength="1"></path>
      </svg>
    </div>
    <p class="lede">
      A unified control center for AI coding accounts, usage and sessions.<span class="more"> See every Claude account's tide and switch before one runs dry. AI is the first section; DevOps, Cloud and SRE are being explored.</span>
    </p>
    <div class="action" id="install-top">
      <Install release={release} />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: max(640px, min(100svh, 1000px));
    display: grid;
    align-items: end;
    padding-bottom: clamp(40px, 6vw, 88px);
    isolation: isolate;
  }

  .art {
    position: absolute;
    z-index: -1;
    top: clamp(16px, 4vh, 48px);
    right: max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter)));
    height: clamp(360px, 78vh, 860px);
    aspect-ratio: 44 / 60;
  }
  .art :global(.hero-mark) {
    width: 100%;
    height: 100%;
  }

  /* Full-bleed water between the headline and the lede; it passes behind the mark. */
  .tide {
    position: relative;
    z-index: -2;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    height: clamp(44px, 5vw, 72px);
    margin-block: -6px -10px;
  }
  .tideline {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .tideline-path {
    fill: none;
    stroke: var(--live);
    stroke-width: 2.25px;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  .copy {
    display: grid;
    gap: 24px;
    padding-top: clamp(24px, 7vh, 64px);
  }
  .copy .lede {
    max-width: 46ch;
  }

  .title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(3rem, min(7.4vw, 10.5vh), 6rem);
    line-height: 0.96;
    letter-spacing: -0.04em;
    max-width: 11ch;
  }

  .action {
    margin-top: 4px;
    /* Clear the mark: frame width minus the mark's box (height × 44/60) and a 48px margin. */
    max-width: min(52rem, calc(min(100vw, var(--max)) - 2 * var(--gutter) - clamp(360px, 78vh, 860px) * 44 / 60 - 48px));
  }

  @media (prefers-reduced-motion: no-preference) {
    .tideline-path {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: tide-draw 2.4s cubic-bezier(0.65, 0, 0.35, 1) 1.9s forwards;
    }
    .tideline {
      animation: swell 7s ease-in-out 4.3s infinite alternate;
    }
  }

  @keyframes tide-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes swell {
    from {
      transform: translateY(0) scaleY(1);
    }
    to {
      transform: translateY(4px) scaleY(0.82);
    }
  }

  @media (max-height: 760px) {
    .more {
      display: none;
    }
  }

  @media (max-width: 760px) {
    .hero {
      min-height: 0;
      align-items: start;
      padding-top: 8px;
    }
    .art {
      position: relative;
      right: auto;
      top: auto;
      height: min(26vh, 220px);
      margin-left: auto;
      margin-right: var(--gutter);
    }
    .copy {
      padding-top: 28px;
      gap: 18px;
    }
    .more {
      display: none;
    }
    .action {
      max-width: none;
    }
  }
</style>
