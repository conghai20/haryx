---
// The HaryX mark ("Wing H"), drawn as its two halves. In the hero each half is
// first traced as a single stroke, then filled: the X is drawn, not shown.
interface Props {
  class?: string;
  animate?: boolean;
  label?: string;
}
const { class: className, animate = false, label } = Astro.props;
const HALF =
  "M-16 -19 L-9.1 -19 L-9.1 -11.7 L-3.8 -5.4 C3 -10.5 11.5 -12.8 16 -19 C14 -12.5 7 -6.2 -4.5 2.5 L-16 -11.7 Z";
---

<svg
  class:list={["mark", className, { "mark--draw": animate }]}
  viewBox="-22 -30 44 60"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
>
  <g transform="scale(1.228)">
    <g class="drift drift--b">
      <g class="half half--b" transform="rotate(180) scale(1.05 1.2)">
        <path class="fill" d={HALF} />
        {animate && <path class="trace" d={HALF} pathLength="1" />}
      </g>
    </g>
    <g class="drift drift--a">
      <g class="half half--a" transform="scale(1.05 1.2)">
        <path class="fill" d={HALF} />
        {animate && <path class="trace" d={HALF} pathLength="1" />}
      </g>
    </g>
  </g>
</svg>

<style>
  .mark {
    display: block;
    overflow: visible;
  }
  .half--a {
    color: var(--mark-a);
  }
  /* Routing drift (hero only): the halves part as the page scrolls and lean toward the pointer.
     --split, --px and --py are set by scripts/motion.ts; units are SVG user units. */
  .drift {
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .drift--a {
    transform: translate(
      calc(var(--split, 0) * 2.4px + var(--px, 0) * 1.6px),
      calc(var(--split, 0) * -2px + var(--py, 0) * 1.2px)
    );
  }
  .drift--b {
    transform: translate(
      calc(var(--split, 0) * -2.4px - var(--px, 0) * 1.6px),
      calc(var(--split, 0) * 2px - var(--py, 0) * 1.2px)
    );
  }
  .half--b {
    color: var(--mark-b);
  }
  .fill {
    fill: currentColor;
  }
  .trace {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.25px;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* A mark inside an unrevealed [data-reveal] waits; it draws when revealed. */
    :global([data-reveal]:not(.is-in)) .mark--draw .trace,
    :global([data-reveal]:not(.is-in)) .mark--draw .fill {
      animation-play-state: paused;
    }
    .mark--draw .trace {
      opacity: 1;
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation:
        trace 1.7s cubic-bezier(0.65, 0, 0.35, 1) var(--d, 0.2s) forwards,
        fade-out 0.8s ease-out calc(var(--d, 0.2s) + 1.9s) forwards;
    }
    .mark--draw .fill {
      opacity: 0;
      animation: flood 1.1s cubic-bezier(0.16, 1, 0.3, 1) calc(var(--d, 0.2s) + 1.35s) forwards;
    }
    .mark--draw .half--b {
      --d: 0.45s;
    }
  }

  @keyframes trace {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes flood {
    from {
      opacity: 0;
      clip-path: inset(100% 0 0 0);
    }
    to {
      opacity: 1;
      clip-path: inset(0 0 0 0);
    }
  }
  @keyframes fade-out {
    to {
      opacity: 0;
    }
  }
</style>
