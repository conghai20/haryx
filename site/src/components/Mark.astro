---
// The HaryX mark ("Wing H"), drawn as its two halves. With `animate`, each half carries a
// trace path so scripts/motion.ts can draw it as a single stroke, then fill it.
interface Props {
  class?: string;
  animate?: boolean;
  label?: string;
}
const { class: className, animate = false, label } = Astro.props;
const HALF =
  "M-16 -19 L-9.1 -19 L-9.1 -11.7 L-3.8 -5.4 C3 -10.5 11.5 -12.8 16 -19 C14 -12.5 7 -6.2 -4.5 2.5 L-16 -11.7 Z";
---

<svg
  class:list={["mark", className, { "mark--draw": animate }]}
  viewBox="-22 -30 44 60"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
>
  <g transform="scale(1.228)">
    <g class="drift drift--b">
      <g class="half half--b" transform="rotate(180) scale(1.05 1.2)">
        <path class="fill" d={HALF} />
        {animate && <path class="trace" d={HALF} pathLength="1" />}
      </g>
    </g>
    <g class="drift drift--a">
      <g class="half half--a" transform="scale(1.05 1.2)">
        <path class="fill" d={HALF} />
        {animate && <path class="trace" d={HALF} pathLength="1" />}
      </g>
    </g>
  </g>
</svg>

<style>
  .mark {
    display: block;
    overflow: visible;
  }
  .half--a {
    color: var(--mark-a);
  }
  /* Routing drift: in the hero the halves part as the page scrolls and lean toward the pointer;
     at the close they start apart and join.
     --split, --px and --py are set by scripts/motion.ts; units are SVG user units. */
  .drift {
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .drift--a {
    transform: translate(
      calc(var(--split, 0) * 2.4px + var(--px, 0) * 1.6px),
      calc(var(--split, 0) * -2px + var(--py, 0) * 1.2px)
    );
  }
  .drift--b {
    transform: translate(
      calc(var(--split, 0) * -2.4px - var(--px, 0) * 1.6px),
      calc(var(--split, 0) * 2px - var(--py, 0) * 1.2px)
    );
  }
  .half--b {
    color: var(--mark-b);
  }
  .fill {
    fill: currentColor;
  }
  .trace {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.25px;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    opacity: 0;
  }

  /* The hero draws the mark (scripts/motion.ts: trace each half, then flood it). The trace stays
     hidden until the script sets it up; the fill's starting state is held only while the motion
     script is due; see Hero.astro. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js:not([data-still]):not(.no-motion)) .mark--draw .fill {
      opacity: 0;
      clip-path: inset(100% 0 0 0);
    }
  }
</style>
