---
// Roadmap from docs/roadmap.md. A tide fills the rail as you scroll, up to "now",
// lighting each milestone it reaches. No dates are promised.
import type { Release } from "../lib/release";
import { REPO_URL } from "../lib/release";

interface Props {
  release: Release | null;
}
const { release } = Astro.props;

type Stage = "shipped" | "next" | "later";
interface Stop {
  title: string;
  line: string;
}
interface Group {
  stage: Stage;
  label: string;
  stops: readonly Stop[];
}

const GROUPS: readonly Group[] = [
  {
    stage: "shipped",
    label: "Shipped",
    stops: [
      { title: "The haryx CLI", line: "Every claude-swap command rebuilt in Rust, drop-in compatible, for macOS, Linux and Windows." },
      { title: "HaryX for macOS", line: "A menu bar app: usage at a glance, switching, sign-in and a dashboard with every control." },
      { title: "HaryX for Windows", line: "A tray app with a flyout and a dashboard over the same CLI." },
      { title: "Setup profiles", line: "Carry your Claude Code setup to another machine in one file, with a dry run and rollback." },
    ],
  },
  {
    stage: "next",
    label: "Next",
    stops: [
      { title: "Updates inside the apps", line: "Download, verify and install new versions from About & Updates." },
      { title: "Usage history", line: "Tokens and API-price cost by account, project, session and model, kept on your machine." },
      { title: "Continue on another account", line: "When an account runs out, resume the same conversation on another in one click." },
      { title: "More ways to install", line: "Homebrew, crates.io, pip and npm, and a signed, notarized DMG." },
    ],
  },
  {
    stage: "later",
    label: "Later",
    stops: [
      { title: "HaryX server", line: "Sync and a team view. It receives metadata only, never credentials." },
      { title: "Web dashboard", line: "Your accounts and sessions from any browser." },
      { title: "iOS and Android", line: "Native apps." },
      { title: "New sections", line: "DevOps, Cloud, SRE and DevSecOps. Being explored; not built." },
    ],
  },
];
---

<section class="roadmap frame" id="roadmap" aria-labelledby="roadmap-title">
  <div class="head" data-reveal>
    <h2 id="roadmap-title" class="section-title">Where the tide goes&nbsp;next.</h2>
    <p class="lede">
      What has shipped, what is being built, and what comes after. No dates; the order inside Next and Later can change.
      The full list lives in <a href={`${REPO_URL}/blob/main/docs/roadmap.md`}>docs/roadmap.md</a>.
    </p>
  </div>

  <div class="road" data-roadmap>
    <div class="rail" aria-hidden="true">
      <span class="fill" data-roadmap-fill></span>
    </div>

    {
      GROUPS.map((g) => (
        <>
          {g.stage === "next" && (
            <p class="now" data-roadmap-now>
              <span class="now-mark" aria-hidden="true" />
              <span>
                You are here{release ? <> · HaryX {release.version}</> : null}
              </span>
            </p>
          )}
          <div class:list={["group", `group--${g.stage}`]}>
            <h3 class="group-label" data-reveal="wipe">
              {g.label}
            </h3>
            <ul class="stops">
              {g.stops.map((s) => (
                <li class="stop" data-stop>
                  <span class="node" aria-hidden="true" />
                  <span class="stop-title">{s.title}</span>
                  <span class="stop-line">{s.line}</span>
                </li>
              ))}
            </ul>
          </div>
        </>
      ))
    }
  </div>
</section>

<style>
  .roadmap {
    padding-top: var(--space-section);
    display: grid;
    gap: clamp(48px, 7vw, 88px);
  }
  .head {
    display: grid;
    gap: 22px;
    max-width: 48rem;
  }

  .road {
    --rail-x: 11px;
    position: relative;
    display: grid;
    gap: clamp(40px, 6vw, 72px);
    padding-left: 56px;
  }

  .rail {
    position: absolute;
    left: var(--rail-x);
    top: 10px;
    bottom: 10px;
    width: 0;
    border-left: 2px dashed var(--rule-strong);
  }
  .fill {
    position: absolute;
    left: -2px;
    top: 0;
    width: 2px;
    height: var(--now-at, 0px);
    background: var(--live);
    transform-origin: top;
    transform: scaleY(0);
    will-change: transform;
  }

  .group {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    column-gap: clamp(16px, 3vw, 48px);
    row-gap: 18px;
    align-items: start;
  }
  .group-label {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2rem, 4.4vw, 3.5rem);
    line-height: 1;
    letter-spacing: -0.035em;
  }
  .group--later .group-label {
    color: transparent;
    -webkit-text-stroke: 1.25px var(--ink-3);
  }

  .stops {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule-strong);
  }
  .stop {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    column-gap: 24px;
    row-gap: 4px;
    padding-block: 18px;
    border-bottom: 1px solid var(--rule);
  }
  /* Only the words move: a transform on .stop would make it the nodes' containing block. */
  .stop-title,
  .stop-line {
    opacity: 0.38;
    transform: translateX(-10px);
    transition:
      opacity 0.7s var(--ease-out),
      transform 0.9s var(--ease-out);
  }
  .stop-line {
    transition-delay: 0.08s;
  }
  .stop.is-lit .stop-title,
  .stop.is-lit .stop-line {
    opacity: 1;
    transform: none;
  }
  .stop-title {
    font-weight: 500;
    font-size: 1.125rem;
  }
  .stop-line {
    color: var(--ink-2);
  }

  /* Each node is positioned against the road (the nearest positioned box), so it lands on
     the rail; with no top it keeps its in-flow height, level with its stop. */
  .node {
    position: absolute;
    margin-top: 6px;
    left: calc(var(--rail-x) - 5px);
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--ground);
    border: 2px solid var(--rule-strong);
    transition:
      background-color 0.5s var(--ease-out),
      border-color 0.5s var(--ease-out),
      transform 0.6s var(--ease-out);
  }
  .group--shipped .stop.is-lit .node {
    background: var(--live);
    border-color: var(--live);
    transform: scale(1.15);
  }
  .group--next .stop.is-lit .node {
    border-color: var(--live);
  }
  .group--later .stop.is-lit .node {
    border-style: dashed;
    border-color: var(--ink-3);
  }

  .now {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--live);
  }
  .now-mark {
    position: absolute;
    left: calc(var(--rail-x) - 8px);
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 2px solid var(--live);
    background: var(--ground);
  }
  .road.is-now .now-mark::after {
    content: "";
    position: absolute;
    inset: -2px;
    border-radius: 50%;
    border: 2px solid var(--live);
    animation: now-ripple 2.6s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }
  @keyframes now-ripple {
    from {
      transform: scale(1);
      opacity: 0.9;
    }
    to {
      transform: scale(2.6);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stop-title,
    .stop-line {
      opacity: 1;
      transform: none;
    }
    .road.is-now .now-mark::after {
      animation: none;
      opacity: 0;
    }
  }

  @media (max-width: 900px) {
    .group,
    .stop {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .road {
      padding-left: 36px;
      --rail-x: 7px;
    }
  }
</style>
