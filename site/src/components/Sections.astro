---
// HaryX as one control center with sections. AI is live; the rest are being
// explored (docs/roadmap.md: undecided, after the AI core ships). No promises,
// so the unbuilt sections get one quiet row, not display type.
const EXPLORING = ["DevOps", "Cloud", "SRE", "DevSecOps"] as const;
---

<section class="sections frame" id="sections" aria-labelledby="sections-title">
  <div class="intro" data-reveal>
    <h2 id="sections-title" class="section-title">One control center. More sections to&nbsp;come.</h2>
    <p class="lede">AI is the first section, and the only one built.</p>
  </div>

  <ol class="index">
    <li class="entry entry--live" data-reveal="wipe">
      <span class="name">AI</span>
      <span class="meta">
        <span class="state state--live"><span class="pip" aria-hidden="true"></span>Live</span>
        <span class="what">Claude accounts, usage, sessions and setup profiles.</span>
        <code class="cmd">haryx ai</code>
      </span>
    </li>
    <li class="entry entry--later" data-reveal="wipe" style="--i:1">
      <span class="later-names">
        {
          EXPLORING.map((name, i) => (
            <>
              {i > 0 && (
                <span class="sep" aria-hidden="true">
                  /
                </span>
              )}
              <span>{name}</span>
            </>
          ))
        }
      </span>
      <span class="meta">
        <span class="state"><span class="pip" aria-hidden="true"></span>Exploring, not built</span>
        <span class="what">Which comes next is undecided; work starts after the AI core ships.</span>
      </span>
    </li>
  </ol>
</section>

<style>
  .sections {
    padding-top: var(--space-section);
    display: grid;
    /* minmax(0, …): a long unbreakable title must wrap, not widen the track past the screen. */
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(40px, 6vw, 72px);
  }
  .intro {
    display: grid;
    gap: 22px;
    max-width: 52rem;
  }

  .index {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule-strong);
  }

  .entry {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    align-items: center;
    column-gap: clamp(20px, 4vw, 64px);
    row-gap: 10px;
    padding-block: clamp(14px, 2vw, 22px);
    border-bottom: 1px solid var(--rule);
  }

  /* Exhibition-index type for the one section that exists. */
  .name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(3rem, 9vw, 7.5rem);
    line-height: 0.95;
    letter-spacing: -0.045em;
    color: var(--ink);
  }

  .later-names {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.1em 0.45em;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--ink-3);
  }
  .sep {
    color: var(--rule-strong);
    font-weight: 400;
  }

  .meta {
    display: grid;
    gap: 6px;
    align-content: center;
  }
  .state {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8125rem;
    color: var(--ink-3);
  }
  .state--live {
    color: var(--live);
    font-weight: 600;
  }
  .pip {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 1.5px solid currentColor;
  }
  .state--live .pip {
    background: currentColor;
  }
  .what {
    color: var(--ink-2);
    max-width: 40ch;
  }
  .cmd {
    font-size: 0.875rem;
    color: var(--ink-2);
  }
  .cmd::before {
    content: "$ ";
    color: var(--live);
  }

  @media (max-width: 760px) {
    .entry {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
